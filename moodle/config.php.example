<?php
// ============================================================================
//  Ejemplo de config.php de Moodle para San Luquitas Digital.
//  NO se usa tal cual: docker/entrypoint.sh genera el config.php real al
//  arrancar el contenedor, leyendo las variables de entorno del compose
//  (así la contraseña de la BD nunca queda escrita en el repositorio).
// ============================================================================
unset($CFG);
global $CFG;
$CFG = new stdClass();

$CFG->dbtype    = 'pgsql';
$CFG->dblibrary = 'native';
$CFG->dbhost    = 'postgres';                 // servicio de PostgreSQL en la red "backend"
$CFG->dbname    = 'moodle_db';
$CFG->dbuser    = 'moodle_user';
$CFG->dbpass    = getenv('MOODLE_DB_PASSWORD'); // nunca escrita en el archivo
$CFG->prefix    = 'mdl_';
$CFG->dboptions = ['dbpersist' => 0, 'dbport' => 5432, 'dbsocket' => ''];

$CFG->wwwroot   = 'https://moodle.sanluquitas.local';
$CFG->dataroot  = '/var/www/moodledata';      // fuera de la raíz web
$CFG->admin     = 'admin';
$CFG->directorypermissions = 02777;

require_once(__DIR__ . '/lib/setup.php'); // No editar
