# ============================================================================
#  Variables del sistema San Luquitas. Copiar a .env y CAMBIAR las contraseñas:
#      cp .env.example .env
#  El .env real NUNCA se sube al repositorio (está en .gitignore).
#  Generar contraseñas aleatorias:  openssl rand -base64 24
# ============================================================================

# Perfiles opcionales de compose: moodle (Julian), tunnel (Samuel). Ej.: moodle,tunnel
COMPOSE_PROFILES=

# --- Portal Laravel ---------------------------------------------------------
APP_NAME="Portal San Luquitas"
APP_ENV=production
# Generar con:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CAMBIAR_GENERAR_CON_OPENSSL
APP_DEBUG=false
APP_URL=https://portal.sanluquitas.local
LOG_LEVEL=info
MOODLE_URL=https://moodle.sanluquitas.local
# true mientras no exista el login con roles; luego false (solo admin edita novedades)
PORTAL_EDICION_ABIERTA=true

# --- PostgreSQL 16 ----------------------------------------------------------
# Superusuario: solo para administrar (crear BD, respaldos). Las apps no lo usan.
POSTGRES_SUPERUSER=sl_admin
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario-lab
# Usuario de cada aplicación, cada uno dueño de su BD (moodle_db / laravel_db)
MOODLE_DB_PASSWORD=cambiar-moodle-lab
LARAVEL_DB_PASSWORD=cambiar-laravel-lab

# --- Redis 7 ----------------------------------------------------------------
REDIS_PASSWORD=cambiar-redis-lab

# --- Cloudflare Tunnel (perfil "tunnel", Samuel) -----------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Respaldos (scripts/backup.sh) ------------------------------------------
# Clave con la que se cifran .env y config.php dentro del respaldo
BACKUP_PASSPHRASE=cambiar-clave-respaldo-lab
