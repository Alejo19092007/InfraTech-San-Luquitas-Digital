# ============================================================================
#  Variables del sistema San Luquitas. Copiar a .env y CAMBIAR las contraseñas:
#      cp .env.example .env
#  El .env real NUNCA se sube al repositorio (está en .gitignore).
#  Generar contraseñas aleatorias:  openssl rand -base64 24
# ============================================================================

# Perfiles opcionales de compose: moodle (Julian), tunnel (Samuel). Ej.: moodle,tunnel
COMPOSE_PROFILES=

# --- Portal Laravel ---------------------------------------------------------
APP_NAME="Portal San Luquitas"
APP_ENV=production
# Generar con:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CAMBIAR_GENERAR_CON_OPENSSL
APP_DEBUG=false
APP_URL=https://portal.sanluquitas.local
LOG_LEVEL=info
MOODLE_URL=https://moodle.sanluquitas.local
# Edición de noticias: solo el rol admin (false). Con true queda abierta sin login.
PORTAL_EDICION_ABIERTA=false
PORTAL_CLAVE_DEMO=             # contraseña de las cuentas ficticias de demostración; si queda vacía se usa la de ejemplo

# --- PostgreSQL 16 ----------------------------------------------------------
# Superusuario: solo para administrar (crear BD, respaldos). Las apps no lo usan.
POSTGRES_SUPERUSER=sl_admin
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario-lab
# Usuario de cada aplicación, cada uno dueño de su BD (moodle_db / laravel_db)
MOODLE_DB_PASSWORD=cambiar-moodle-lab
# Moodle (perfil "moodle"): contraseña del admin y de los usuarios ficticios del curso
# (mínimo 8 caracteres con mayúscula, minúscula, número y símbolo)
MOODLE_ADMIN_PASSWORD=Cambiar#Admin2026
MOODLE_USERS_PASSWORD=Cambiar#Aula2026
LARAVEL_DB_PASSWORD=cambiar-laravel-lab

# --- Redis 7 ----------------------------------------------------------------
REDIS_PASSWORD=cambiar-redis-lab

# --- WhatsApp Cloud API (Meta) y bot — Samuel ---------------------------------
# Los valores reales van SOLO en el .env del servidor (nunca en el repositorio).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# IA que interpreta mensajes ambiguos (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- ngrok (perfil "tunnel", Samuel) ----------------------------------------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=               # dominio fijo gratuito, sin https://

# --- Respaldos (scripts/backup.sh) ------------------------------------------
# Clave con la que se cifran .env y config.php dentro del respaldo
BACKUP_PASSPHRASE=cambiar-clave-respaldo-lab
